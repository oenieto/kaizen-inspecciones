# Copia este archivo a .env.local. Las tres primeras de Supabase son obligatorias;
# con `pnpm exec supabase start` se imprimen las del entorno local.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable/anon key (pública: la seguridad la da RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret/service_role key: solo servidor (seed y reinicio de la demo). Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Tenant cuyo branding muestra el login
TENANT_SLUG=uv-energia

# Demo: el login lista las cuentas y precarga la contraseña; habilita «Reiniciar datos de demo».
# En productivo déjalo en false.
MODO_DEMO=true
# Contraseña de las cuentas que crea `pnpm seed` (mínimo 8 caracteres)
SEED_PASSWORD=

# Revisión de completitud con IA (sin clave: solo reglas)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# PDF del dictamen: docker run --rm -p 3001:3000 gotenberg/gotenberg:8
GOTENBERG_URL=

# Avisos de eventos a n8n (opcional); el secreto viaja en X-Webhook-Secret
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Mapa real de la ruta del día (Mapbox, free tier)
NEXT_PUBLIC_MAPBOX_TOKEN=
